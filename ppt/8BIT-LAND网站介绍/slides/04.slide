        <Text style={{ fontSize: 24, lineHeight: 1.2, letterSpacing: 3, color: 'rgba(231,158,196,0.85)' }}>03 / MODULE 02</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 88, width: 88, height: 6, background: '#E79EC4' }} />

    {/* B 区上：卷帘横带 */}
    <Box style={{ position: 'absolute', left: 64, top: 124, width: 1152, height: 357, background: '#14101F', border: '2px solid rgba(242,233,255,0.18)', boxShadow: '8px 8px 0 rgba(20,16,31,0.7)' }}>
        <Image src='assets/ui_comp_band.png' style={{ width: 1148, height: 353, objectFit: 'cover' }} />
    </Box>

    {/* B 区下：三卡等高 */}
    <Box style={{ position: 'absolute', left: 64, top: 500, width: 1152, flexDirection: 'row', gap: 24 }}>

        <Box style={{ width: 368, height: 140, background: 'rgba(242,233,255,0.05)', border: '1px solid rgba(242,233,255,0.14)', paddingTop: 18, paddingBottom: 18, paddingLeft: 20, paddingRight: 20, flexDirection: 'column' }}>
            <Text style={{ fontSize: 21, lineHeight: 1.3, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>16 × 13 的网格</Text>
            <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 8 }}>横轴是 16 个十六分音符，纵轴按音高排。点一格写一个音，拖一下就是一串。</Text>
        </Box>

        <Box style={{ width: 368, height: 140, background: 'rgba(242,233,255,0.05)', border: '1px solid rgba(242,233,255,0.14)', paddingTop: 18, paddingBottom: 18, paddingLeft: 20, paddingRight: 20, flexDirection: 'column' }}>
            <Text style={{ fontSize: 21, lineHeight: 1.3, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>字母键就是琴键</Text>
            <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 8 }}>A 到 L 是白键，W E T Y U O P 是黑键。按播放再敲键，音符自动写进格子。</Text>
        </Box>

        <Box style={{ width: 368, height: 140, background: 'rgba(242,233,255,0.05)', border: '1px solid rgba(242,233,255,0.14)', paddingTop: 18, paddingBottom: 18, paddingLeft: 20, paddingRight: 20, flexDirection: 'column' }}>
            <Text style={{ fontSize: 21, lineHeight: 1.3, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>参数全在顶栏</Text>
            <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 8 }}>BPM、四种波形、鼓点开关、清空、存成 WAV，一行排完，不用翻菜单。</Text>
        </Box>

    </Box>

    {/* C 区：页脚 */}
