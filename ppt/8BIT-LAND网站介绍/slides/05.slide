<Slide style={{ width: 1280, height: 720, background: '#14101F', position: 'relative', overflow: 'hidden', fontFamily: 'mplus_hzk_12' }}>

    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 720, background: 'radial-gradient(circle at 76% 26%, rgba(147,220,228,0.10) 0%, rgba(20,16,31,0) 55%)' }} />

    {/* A 区：标题块 */}
    <Box style={{ position: 'absolute', left: 64, top: 28, flexDirection: 'row', alignItems: 'flex-end', gap: 22 }}>
        <Text style={{ fontSize: 36, lineHeight: 1.3, letterSpacing: 2, color: '#F2E9FF' }}>把一首歌，压回芯片里</Text>
        <Text style={{ fontSize: 24, lineHeight: 1.2, letterSpacing: 3, color: 'rgba(231,158,196,0.85)' }}>04 / MODULE 03</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 88, width: 88, height: 6, background: '#E79EC4' }} />

    {/* B 区左：三步竖排 */}
    <Box style={{ position: 'absolute', left: 64, top: 132, width: 336, flexDirection: 'column' }}>
        <Text style={{ fontSize: 24, lineHeight: 1.4, color: '#93DCE4' }}>三步走完</Text>

        <Box style={{ flexDirection: 'row', gap: 14, marginTop: 22 }}>
            <Text style={{ fontSize: 24, lineHeight: 1, color: 'rgba(231,158,196,0.9)' }}>01</Text>
            <Box style={{ flexDirection: 'column', width: 292 }}>
                <Text style={{ fontSize: 21, lineHeight: 1.3, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>拖进来</Text>
                <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 4 }}>MP3、WAV、OGG、M4A 四种格式，拖进虚线框就行。</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 14, marginTop: 10 }}>
            <Text style={{ fontSize: 24, lineHeight: 1, color: 'rgba(231,158,196,0.9)' }}>02</Text>
            <Box style={{ flexDirection: 'column', width: 292 }}>
                <Text style={{ fontSize: 21, lineHeight: 1.3, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>挑个预设</Text>
                <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 4 }}>三个预设一键配好位深和采样率，也能自己拖滑块。</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 14, marginTop: 10 }}>
            <Text style={{ fontSize: 24, lineHeight: 1, color: 'rgba(231,158,196,0.9)' }}>03</Text>
            <Box style={{ flexDirection: 'column', width: 292 }}>
                <Text style={{ fontSize: 21, lineHeight: 1.3, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>转成 WAV</Text>
                <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 4 }}>解码、降采样、量化、编码一次跑完，直接下载 WAV。</Text>
            </Box>
        </Box>
    </Box>

    {/* 左下：补充说明 */}
    <Box style={{ position: 'absolute', left: 64, top: 540, width: 336, height: 88, background: 'rgba(147,220,228,0.07)', borderLeft: '4px solid #93DCE4', paddingLeft: 18, paddingRight: 16, justifyContent: 'center' }}>
        <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.62)', fontFamily: 'Microsoft YaHei' }}>
            位深、采样率、音量都摊在面板上，没有藏在二级菜单里。
        </Text>
    </Box>

    {/* B 区中：控制面板截图 */}
    <Box style={{ position: 'absolute', left: 424, top: 132, width: 414, height: 464, background: '#14101F', border: '2px solid rgba(242,233,255,0.18)', boxShadow: '8px 8px 0 rgba(20,16,31,0.7)' }}>
        <Image src='assets/ui_conv_panel.png' style={{ width: 410, height: 460, objectFit: 'cover' }} />
    </Box>

    <Text style={{ position: 'absolute', left: 424, top: 610, width: 414, fontSize: 14, lineHeight: 1.7, letterSpacing: 1, color: 'rgba(242,233,255,0.45)' }}>
        CONVERTER.EXE · 左侧控制面板
    </Text>

    {/* B 区右：参数清单 */}
    <Box style={{ position: 'absolute', left: 866, top: 132, width: 286, flexDirection: 'column' }}>
        <Text style={{ fontSize: 21, lineHeight: 1.4, color: '#93DCE4' }}>面板上的四个数</Text>

        <Box style={{ flexDirection: 'column', marginTop: 16 }}>
            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', paddingBottom: 8 }}>
                <Text style={{ fontSize: 17, lineHeight: 1.4, color: 'rgba(242,233,255,0.55)', fontFamily: 'Microsoft YaHei' }}>位深</Text>
                <Text style={{ fontSize: 21, lineHeight: 1.2, color: '#F2E9FF' }}>4 bit</Text>
            </Box>
            <Box style={{ width: 286, height: 1, background: 'rgba(242,233,255,0.12)' }} />

            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', paddingTop: 14, paddingBottom: 8 }}>
                <Text style={{ fontSize: 17, lineHeight: 1.4, color: 'rgba(242,233,255,0.55)', fontFamily: 'Microsoft YaHei' }}>采样率</Text>
                <Text style={{ fontSize: 21, lineHeight: 1.2, color: '#F2E9FF' }}>11,000 Hz</Text>
            </Box>
            <Box style={{ width: 286, height: 1, background: 'rgba(242,233,255,0.12)' }} />

            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', paddingTop: 14, paddingBottom: 8 }}>
                <Text style={{ fontSize: 17, lineHeight: 1.4, color: 'rgba(242,233,255,0.55)', fontFamily: 'Microsoft YaHei' }}>音量</Text>
                <Text style={{ fontSize: 21, lineHeight: 1.2, color: '#F2E9FF' }}>100%</Text>
            </Box>
            <Box style={{ width: 286, height: 1, background: 'rgba(242,233,255,0.12)' }} />

            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', paddingTop: 14, paddingBottom: 8 }}>
                <Text style={{ fontSize: 17, lineHeight: 1.4, color: 'rgba(242,233,255,0.55)', fontFamily: 'Microsoft YaHei' }}>芯片过载</Text>
                <Text style={{ fontSize: 21, lineHeight: 1.2, color: '#E79EC4' }}>开</Text>
            </Box>
            <Box style={{ width: 286, height: 1, background: 'rgba(242,233,255,0.12)' }} />
        </Box>

        <Text style={{ width: 286, fontSize: 17, lineHeight: 1.75, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 20 }}>
            这是「标准 8BIT」预设的默认值：数值越低，颗粒越粗。转换全程本地跑，音频不出浏览器。
        </Text>
    </Box>

    {/* C 区：页脚 */}
    <Box style={{ position: 'absolute', left: 64, top: 668, width: 1152, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 8, height: 8, background: '#E79EC4' }} />
            <Text style={{ fontSize: 14, lineHeight: 1.4, letterSpacing: 2, color: 'rgba(242,233,255,0.38)' }}>8BIT LAND</Text>
        </Box>
        <Text style={{ fontSize: 14, lineHeight: 1.4, letterSpacing: 2, color: 'rgba(242,233,255,0.38)' }}>05 / 08</Text>
    </Box>

</Slide>
