<Slide style={{ width: 1280, height: 720, background: '#14101F', position: 'relative', overflow: 'hidden', fontFamily: 'mplus_hzk_12' }}>

    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 720, background: 'radial-gradient(circle at 18% 30%, rgba(231,158,196,0.09) 0%, rgba(20,16,31,0) 52%)' }} />

    {/* A 区：标题块 */}
    <Box style={{ position: 'absolute', left: 64, top: 28, flexDirection: 'row', alignItems: 'flex-end', gap: 22 }}>
        <Text style={{ fontSize: 36, lineHeight: 1.3, letterSpacing: 2, color: '#F2E9FF' }}>按下一个键，和弦自己长出来</Text>
        <Text style={{ fontSize: 24, lineHeight: 1.2, letterSpacing: 3, color: 'rgba(231,158,196,0.85)' }}>02 / MODULE 01</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 88, width: 88, height: 6, background: '#E79EC4' }} />

    {/* B 区左：主视觉 58% */}
    <Box style={{ position: 'absolute', left: 64, top: 132, width: 628, height: 385, background: '#14101F', border: '2px solid rgba(242,233,255,0.18)', boxShadow: '8px 8px 0 rgba(20,16,31,0.7)' }}>
        <Image src='assets/ui_lucky.png' style={{ width: 624, height: 381, objectFit: 'cover' }} />
    </Box>

    <Box style={{ position: 'absolute', left: 64, top: 536, width: 628, flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 24, height: 2, background: 'rgba(147,220,228,0.6)' }} />
            <Text style={{ fontSize: 14, lineHeight: 1.7, letterSpacing: 2, color: 'rgba(147,220,228,0.75)' }}>随心和声 · 主窗口</Text>
        </Box>
        <Text style={{ fontSize: 17, lineHeight: 1.75, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 8 }}>
            和弦条常驻底部，左键换和弦、空格出声。调式在 大调 / 小调 / 多利亚 / 都节 之间切换，右下三格实时回显拍号、音量与八度。
        </Text>
    </Box>

    {/* B 区右：三条规则竖排（不做成卡片） */}
    <Box style={{ position: 'absolute', left: 736, top: 128, width: 416, flexDirection: 'column' }}>
        <Text style={{ fontSize: 24, lineHeight: 1.4, color: '#93DCE4' }}>三条规则，让乱按也成调</Text>

        <Box style={{ flexDirection: 'row', gap: 16, marginTop: 18 }}>
            <Text style={{ fontSize: 24, lineHeight: 1, color: 'rgba(231,158,196,0.9)' }}>01</Text>
            <Box style={{ flexDirection: 'column', width: 372 }}>
                <Text style={{ fontSize: 21, lineHeight: 1.3, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>强拍只落和弦音</Text>
                <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 4 }}>拍点一到，只从当前和弦的三个音里挑，撞不到不协和的音。</Text>
            </Box>
        </Box>

        <Box style={{ width: 416, height: 1, background: 'rgba(242,233,255,0.10)', marginTop: 14 }} />

        <Box style={{ flexDirection: 'row', gap: 16, marginTop: 14 }}>
            <Text style={{ fontSize: 24, lineHeight: 1, color: 'rgba(231,158,196,0.9)' }}>02</Text>
            <Box style={{ flexDirection: 'column', width: 372 }}>
                <Text style={{ fontSize: 21, lineHeight: 1.3, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>能级进就不跳进</Text>
                <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 4 }}>优先走相邻音；真的跳了，下一步立刻反向补回来。</Text>
            </Box>
        </Box>

        <Box style={{ width: 416, height: 1, background: 'rgba(242,233,255,0.10)', marginTop: 14 }} />

        <Box style={{ flexDirection: 'row', gap: 16, marginTop: 14 }}>
            <Text style={{ fontSize: 24, lineHeight: 1, color: 'rgba(231,158,196,0.9)' }}>03</Text>
            <Box style={{ flexDirection: 'column', width: 372 }}>
                <Text style={{ fontSize: 21, lineHeight: 1.3, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>导音必须解决</Text>
                <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 4 }}>第七级音一出现，下一步必然落到主音，听感才收得住。</Text>
            </Box>
        </Box>

        <Text style={{ fontSize: 21, lineHeight: 1.3, color: '#E79EC4', marginTop: 22 }}>换套调式，就是换种情绪</Text>
    </Box>

    {/* C 区：页脚 */}
    <Box style={{ position: 'absolute', left: 64, top: 668, width: 1152, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 8, height: 8, background: '#E79EC4' }} />
            <Text style={{ fontSize: 14, lineHeight: 1.4, letterSpacing: 2, color: 'rgba(242,233,255,0.38)' }}>8BIT LAND</Text>
        </Box>
        <Text style={{ fontSize: 14, lineHeight: 1.4, letterSpacing: 2, color: 'rgba(242,233,255,0.38)' }}>03 / 08</Text>
    </Box>

</Slide>
