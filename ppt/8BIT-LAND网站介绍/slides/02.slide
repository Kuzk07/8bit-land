<Slide style={{ width: 1280, height: 720, background: '#14101F', position: 'relative', overflow: 'hidden', fontFamily: 'mplus_hzk_12' }}>

    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 720, background: 'radial-gradient(circle at 76% 20%, rgba(147,220,228,0.10) 0%, rgba(20,16,31,0) 55%)' }} />

    {/* A 区：标题块 */}
    <Box style={{ position: 'absolute', left: 64, top: 28, flexDirection: 'row', alignItems: 'flex-end', gap: 22 }}>
        <Text style={{ fontSize: 36, lineHeight: 1.3, letterSpacing: 2, color: '#F2E9FF' }}>门槛不在灵感，在工具</Text>
        <Text style={{ fontSize: 24, lineHeight: 1.2, letterSpacing: 3, color: 'rgba(231,158,196,0.85)' }}>01 / WHY</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 88, width: 88, height: 6, background: '#E79EC4' }} />

    {/* B 区左：三条门槛竖排 */}
    <Box style={{ position: 'absolute', left: 64, top: 132, width: 640, flexDirection: 'column' }}>
        <Text style={{ fontSize: 24, lineHeight: 1.5, color: '#93DCE4' }}>三座门槛，挡住了「随便玩一下」</Text>

        <Box style={{ flexDirection: 'row', gap: 18, marginTop: 30 }}>
            <Text style={{ fontSize: 24, lineHeight: 1, color: 'rgba(231,158,196,0.9)' }}>01</Text>
            <Box style={{ flexDirection: 'column', width: 584 }}>
                <Text style={{ fontSize: 21, lineHeight: 1.35, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>先装一个宿主软件</Text>
                <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 6 }}>动辄十几个 G，装完、激活、认界面，热情已经用掉一半。</Text>
            </Box>
        </Box>

        <Box style={{ width: 640, height: 1, background: 'rgba(242,233,255,0.10)', marginTop: 18 }} />

        <Box style={{ flexDirection: 'row', gap: 18, marginTop: 18 }}>
            <Text style={{ fontSize: 24, lineHeight: 1, color: 'rgba(231,158,196,0.9)' }}>02</Text>
            <Box style={{ flexDirection: 'column', width: 584 }}>
                <Text style={{ fontSize: 21, lineHeight: 1.35, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>再找一堆音源素材</Text>
                <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 6 }}>想要那股芯片味，先得知道去哪找 8bit 音色包。</Text>
            </Box>
        </Box>

        <Box style={{ width: 640, height: 1, background: 'rgba(242,233,255,0.10)', marginTop: 18 }} />

        <Box style={{ flexDirection: 'row', gap: 18, marginTop: 18 }}>
            <Text style={{ fontSize: 24, lineHeight: 1, color: 'rgba(231,158,196,0.9)' }}>03</Text>
            <Box style={{ flexDirection: 'column', width: 584 }}>
                <Text style={{ fontSize: 21, lineHeight: 1.35, color: '#F2E9FF', fontFamily: 'Microsoft YaHei' }}>最后还得懂点乐理</Text>
                <Text style={{ fontSize: 17, lineHeight: 1.7, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 6 }}>五线谱、和弦级数、和声进行，够学一学期。</Text>
            </Box>
        </Box>
    </Box>

    {/* 结论条 */}
    <Box style={{ position: 'absolute', left: 64, top: 520, width: 640, height: 96, background: 'rgba(147,220,228,0.08)', borderLeft: '4px solid #93DCE4', paddingLeft: 20, paddingRight: 18, justifyContent: 'center' }}>
        <Text style={{ fontSize: 21, lineHeight: 1.6, color: 'rgba(242,233,255,0.86)', fontFamily: 'Microsoft YaHei' }}>
            所以这里把三件事拆开，做成三个互不依赖的入口：会敲键盘，就能先出声。
        </Text>
    </Box>

    {/* 两栏分隔线，明确左右结构 */}
    <Box style={{ position: 'absolute', left: 726, top: 132, width: 2, height: 484, background: 'rgba(242,233,255,0.09)' }} />

    {/* B 区右：启动页特写 */}
    <Box style={{ position: 'absolute', left: 760, top: 124, width: 456, height: 358, background: '#14101F', border: '2px solid rgba(242,233,255,0.18)', boxShadow: '8px 8px 0 rgba(20,16,31,0.7)' }}>
        <Image src='assets/ui_boot_card.png' style={{ width: 452, height: 354, objectFit: 'cover' }} />
    </Box>
    <Text style={{ position: 'absolute', left: 760, top: 496, width: 456, fontSize: 14, lineHeight: 1.7, letterSpacing: 1, color: 'rgba(242,233,255,0.45)' }}>
        打开就是这一屏：没有注册、没有引导、没有新手任务
    </Text>

    {/* 右下反向强调 */}
    <Box style={{ position: 'absolute', left: 760, top: 524, width: 456, flexDirection: 'column' }}>
        <Text style={{ fontSize: 24, lineHeight: 1.4, color: '#E79EC4' }}>0 个前置条件</Text>
        <Text style={{ fontSize: 17, lineHeight: 1.75, color: 'rgba(242,233,255,0.58)', fontFamily: 'Microsoft YaHei', marginTop: 10 }}>
            不装软件、不注册账号、不上传音频。浏览器能打开，它就能用。
        </Text>
    </Box>

    {/* C 区：页脚 */}
    <Box style={{ position: 'absolute', left: 64, top: 668, width: 1152, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 8, height: 8, background: '#E79EC4' }} />
            <Text style={{ fontSize: 14, lineHeight: 1.4, letterSpacing: 2, color: 'rgba(242,233,255,0.38)' }}>8BIT LAND</Text>
        </Box>
        <Text style={{ fontSize: 14, lineHeight: 1.4, letterSpacing: 2, color: 'rgba(242,233,255,0.38)' }}>02 / 08</Text>
    </Box>

</Slide>
